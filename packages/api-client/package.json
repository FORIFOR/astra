{
  "name": "@astra/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "contracts に対する HTTP / SSE クライアント。desktop と share-web が使う。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
