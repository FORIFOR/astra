<Project Sdk="Microsoft.NET.Sdk">
  <!-- Astra for Windows (WinUI 3 + Windows App SDK). macOS ではビルド不可。CI(windows-latest)で検証する。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Astra</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- unpackaged desktop app: CI の素の dotnet build を MSIX packaging 無しで通す（WinUI 3 標準）。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- AppLogic の各ファイルは using System; 等を暗黙に前提にしている（logic-check/bridge-check と同じ）。
         実ビルドでも同じになるよう ImplicitUsings を有効化する（System/Threading 等を自動 import）。 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 自前の Program.Main（App/Program.cs）を使う。XAML 生成の Main は無効化して二重定義を避ける。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 高 DPI（PerMonitorV2）を宣言。shared token の寸法を実寸で描くため。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <!-- Rust 静的/動的ライブラリ（astra_core.dll）は CI で cargo build 後にコピーする。 -->
  <ItemGroup>
    <None Include="astra_core.dll" Condition="Exists('astra_core.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
