{
  "name": "@astra/service-api-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auth, tenant routing, rate limiting, REST entrypoint and realtime WebSocket fan-out.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm -w dev:gateway",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@astra/contracts": "workspace:*",
    "@astra/db": "workspace:*",
    "@astra/policy": "workspace:*",
    "@astra/service-library": "workspace:*",
    "@astra/service-plugin-registry": "workspace:*",
    "@astra/service-task": "workspace:*",
    "@astra/telemetry": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "kysely": "catalog:",
    "zod": "catalog:",
    "@astra/service-share": "workspace:*",
    "@astra/service-meeting": "workspace:*",
    "@astra/service-research": "workspace:*",
    "@astra/service-agent-runtime": "workspace:*",
    "@astra/service-world-model": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "catalog:",
    "ws": "^8.21.3",
    "@astra/plugin-sdk": "workspace:*"
  }
}
