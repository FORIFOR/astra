{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/test/**/*.ts",
    "services/*/test/**/*.ts",
    "workers/*/test/**/*.ts",
    "evals/**/*.test.ts"
  ]
}
